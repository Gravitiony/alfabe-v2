generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OGRETMEN
  OGRENCI
}

enum MailStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  email          String?       @unique
  passwordHash   String
  role           Role
  displayName    String
  firstName      String?
  lastName       String?
  isActive        Boolean       @default(true)
  activationToken String?
  lastSeenAt      DateTime?
  classId         String?
  classroom      Classroom?    @relation("ClassMembership", fields: [classId], references: [id])
  sentMails      MailMessage[] @relation("SentMails")
  taughtClasses  Classroom[]   @relation("TaughtClasses")
  assignments    Assignment[]  @relation("CreatedAssignments")
  createdAt      DateTime      @default(now())
}

model Classroom {
  id         String       @id @default(cuid())
  name       String       @unique
  teacherId  String
  teacher    User         @relation("TaughtClasses", fields: [teacherId], references: [id])
  students   User[]       @relation("ClassMembership")
  assignments Assignment[]
  createdAt  DateTime     @default(now())
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  dueAt       DateTime?
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  createdById String
  createdBy   User      @relation("CreatedAssignments", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

model MailMessage {
  id         String     @id @default(cuid())
  fromUserId String?
  fromUser   User?      @relation("SentMails", fields: [fromUserId], references: [id])
  toAddress  String
  subject    String
  body       String     @db.Text
  status     MailStatus @default(QUEUED)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime   @default(now())

  @@index([toAddress])
}

model Sponsor {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String   @db.MediumText
  websiteUrl String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}
